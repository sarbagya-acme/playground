{
  "private": true,
  "name": "electron-app",
  "version": "0.0.3",
  "author": "Sarbagya",
  "main": "lib/backend/electron-main.js",
  "dependencies": {
    "@theia/core": "1.63.3",
    "@theia/editor": "1.63.3",
    "@theia/electron": "1.63.3",
    "@theia/filesystem": "1.63.3",
    "@theia/markers": "1.63.3",
    "@theia/messages": "1.63.3",
    "@theia/monaco": "1.63.3",
    "@theia/navigator": "1.63.3",
    "@theia/preferences": "1.63.3",
    "@theia/process": "1.63.3",
    "@theia/terminal": "1.63.3",
    "@theia/workspace": "1.63.3",
    "mango": "0.0.0"
  },
  "devDependencies": {
    "@theia/cli": "1.63.3",
    "electron": "37.2.1",
    "rimraf": "^6.0.1",
    "electron-builder": "26.0.12"
  },
  "scripts": {
    "clean:dist": "rimraf dist",
    "bundle": "npm run rebuild && theia build --mode development",
    "rebuild": "theia rebuild:electron --cacheRoot ..",
    "start": "theia start",
    "watch": "npm run rebuild && theia build --watch --mode development",
    "build": "npm run rebuild && theia build --app-target=\"electron\"",
    "package": "npm run clean:dist && npm run rebuild && electron-builder -c.mac.identity=null --publish never",
    "deploy": "npm run clean:dist && npm run rebuild && electron-builder -c.mac.identity=null --publish always"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Mango",
        "reloadOnReconnect": true,
        "preferences": {
          "toolbar.showToolbar": true,
          "security.workspace.trust.enabled": false
        },
        "electron": {
          "showWindowEarly": false,
          "splashScreenOptions": {
            "content": "resources/TheiaIDESplash.svg",
            "height": 276,
            "width": 446
          }
        }
      }
    },
    "backend": {
      "config": {
        "frontendConnectionTimeout": -1,
        "startupTimeout": -1,
        "resolveSystemPlugins": false,
        "configurationFolder": ".mango"
      }
    },
    "generator": {
      "config": {
        "preloadTemplate": "./resources/preload.html"
      }
    }
  }
}
